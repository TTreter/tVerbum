# =============================================================================
# Arquivo de Exemplo de Configuração de Ambiente (.env) - tVerbum v2.0
# Copie este arquivo para .env e preencha as chaves dos provedores desejados.
# O tVerbum funciona com qualquer uma das chaves gratuitas abaixo.
# =============================================================================

# Provedor prioritário de IA: 'auto' | 'gemini' | 'groq' | 'openrouter' | 'ollama'
AI_PROVIDER=auto

# --- Provedores de IA Gratuitos (preencha ao menos um) ---
# Google AI Studio (Camada gratuita com 1M contexto): https://aistudio.google.com
GEMINI_API_KEY=sua_chave_gemini_aqui
DEFAULT_MODEL=gemini-3.8-flash

# Groq Cloud (Camada gratuita ultra-rápida 250+ tokens/s e Whisper grátis): https://console.groq.com
GROQ_API_KEY=sua_chave_groq_aqui
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# OpenRouter (Modelos gratuitos com tag :free): https://openrouter.ai
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash-exp:free

# Ollama Local (100% Offline e Privado - Opcional): https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Servidor Web Local e Cache Compartilhado ---
PORT=8000
# TVERBUM_CACHE_PATH=C:\temp\tverbum_video_cache.db
